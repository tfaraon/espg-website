---
import ConferenceLayout from '../../layouts/ConferenceLayout.astro';
import Ridgeline from '../../components/conference/Ridgeline.astro';
import { url } from '../../lib/url';

// VUEESC × GESSS 2026 organising committee (not the ESPG society committee, which is on the About page).
const EXECUTIVE = [
  { name: 'Alanis Olesch-Byrne', role: 'Co-Chair' },
  { name: 'Mana Ryuba', role: 'Co-Chair' },
  { name: 'Tom McNamara', role: 'Treasurer' },
  { name: 'Sophie Golding Chan', role: 'Secretary' },
];
const GENERAL = [
  { name: 'James La Greca', role: 'Webmaster and programs' },
  { name: 'Harriet Magee' },
  { name: 'Louisa Sheridan' },
  { name: 'Ahmad Emamian' },
  { name: 'Bianca Estrada Figueroa' },
  { name: 'Anthony Romano' },
  { name: 'Shinta Aritonang' },
  { name: 'Lovensia Albasit' },
  { name: 'Anna Zehrung' },
  { name: 'Bridget Cui' },
  { name: 'Jeremy Wyman' },
  { name: 'Aisyah Mohammad Sulhanuddin' },
];
const SPONSORS = [
  {
    name: 'School of Geography, Earth and Atmospheric Sciences (SGEAS)',
    org: 'University of Melbourne',
    href: 'https://sgeas.unimelb.edu.au/',
  },
  { name: 'Graduate Student Association', org: 'University of Melbourne', href: 'https://gsa.unimelb.edu.au/' },
  {
    name: 'Geological Society of Australia',
    org: 'Victoria Division',
    href: 'https://www.gsa.org.au/communities/divisions/victoria/',
  },
];
---

<ConferenceLayout
  title="Overview"
  description="VUEESC × GESSS 2026 — a free, student-led earth and environmental sciences conference at the University of Melbourne, 5–6 November 2026."
>
  <section class="hero">
    <h1 class="wordmark">VUEESC<span class="x">×</span>GESSS</h1>
    <div class="fullnames">
      <p>Victorian Universities Earth and Environmental Sciences Conference</p>
      <p>GSA Earth Science Student Symposium</p>
    </div>

    <p class="when grad-text">5–6 November 2026</p>
    <p class="where">
      <strong>University of Melbourne</strong><br />
      McCoy Building, Level 2 · Parkville
    </p>
  </section>

  <Ridgeline id="hero" class="hero-ridge" />

  <div class="pills">
    <span class="pill pill-grad">Attendance free</span>
    <span class="pill pill-outline"><strong>Program out now</strong> <a href={url('/conference/program')}>See the program</a></span>
  </div>

  <dl class="meta">
    <div><dt>Dates</dt><dd>Thu 5 – Fri 6 November 2026</dd></div>
    <div><dt>Venue</dt><dd>McCoy Building Lv. 2, Parkville</dd></div>
    <div><dt>Cost</dt><dd>Free</dd></div>
    <div><dt>Open to</dt><dd>Students and staff in geoscience, geography, environmental and climate sciences</dd></div>
  </dl>

  <div class="cols">
    <section>
      <h2>About the conference</h2>
      <p>
        VUEESC × GESSS brings together the Victorian Universities Earth and Environmental
        Sciences Conference and the Geological Society of Australia's Earth Science Student
        Symposium. It is run by students, for students.
      </p>
      <p>
        It is a relaxed place to present your research, whether it's finished work or still in
        progress. You'll get feedback from peers and meet students and researchers from other
        Victorian universities.
      </p>
    </section>

    <section>
      <h2>What to expect</h2>
      <ul class="expect">
        <li>Student talks across geology, geophysics, geography, environmental and climate science</li>
        <li>Poster presentations</li>
        <li>Invited keynote speakers</li>
        <li>Time to meet other students in your field</li>
      </ul>
    </section>
  </div>

  <h2>Attending</h2>
  <p>
    Attendance is free and open to all students and staff in geoscience, geography, environmental
    and climate sciences. The <a href={url('/conference/program')}>program</a> and all
    <a href={url('/conference/abstracts')}>abstracts</a> are now online.
  </p>
  <p>
    <a href={url('/membership')}>Join ESPG</a> to get conference updates by email.
  </p>

  <section id="committee">
    <h2>Organising committee</h2>
    <p class="muted">VUEESC × GESSS 2026 is organised by postgraduate students and hosted by ESPG.</p>
    <h3 class="group">Executive committee</h3>
    <ul class="people people--exec">
      {EXECUTIVE.map((p) => (
        <li><span class="role">{p.role}</span><span class="name">{p.name}</span></li>
      ))}
    </ul>
    <h3 class="group">General committee</h3>
    <ul class="people">
      {GENERAL.map((p) => (
        <li>
          <span class="name">{p.name}</span>
          {p.role && <span class="role">{p.role}</span>}
        </li>
      ))}
    </ul>
  </section>

  <section id="sponsors">
    <h2>Sponsors</h2>
    <p class="muted">Thank you to our sponsors for supporting VUEESC × GESSS 2026.</p>
    <ul class="sponsors">
      {SPONSORS.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            <span class="name">{s.name}</span>
            <span class="org">{s.org}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</ConferenceLayout>

<style>
  .hero { padding-top: clamp(0.5rem, 2vw, 1.5rem); }
  .wordmark {
    font-size: clamp(2.6rem, 10vw, 6.5rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.01em;
    max-width: none;
    margin: 0 0 1.1rem;
    white-space: nowrap;
  }
  .wordmark .x { font-weight: 400; margin: 0 0.08em; }
  .fullnames {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.4rem 2.5rem;
    max-width: 46rem;
    margin-bottom: 2rem;
  }
  .fullnames p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }
  .when {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 0.75rem;
    max-width: none;
    width: fit-content;
  }
  .where { font-size: 1.05rem; line-height: 1.5; margin: 0; }
  .where strong { font-weight: 600; }

  .hero-ridge { margin: 2rem 0 1.75rem; }

  .pills { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2.5rem; }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.25rem 2rem;
    margin: 0 0 1rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .meta dt {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--teal);
    margin-bottom: 0.3rem;
  }
  .meta dd { margin: 0; font-weight: 500; line-height: 1.45; }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 0 3rem;
  }
  .cols > * { min-width: 0; }

  .expect { list-style: none; padding: 0; margin: 0; }
  .expect li {
    padding: 0.55rem 0 0.55rem 1.4rem;
    border-bottom: 1px solid var(--rule);
    position: relative;
  }
  .expect li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.05rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--grad);
  }

  /* Organising committee and sponsors */
  .group {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--teal);
    margin: 1.75rem 0 0.75rem;
  }
  .people,
  .sponsors {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .people { grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr)); }
  /* Four executive roles: 2 × 2, or one row on wide screens, so no card sits alone */
  .people--exec { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 60rem) { .people--exec { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 30rem) { .people--exec { grid-template-columns: 1fr; } }
  .people li {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .people .name { font-weight: 600; line-height: 1.35; }
  .people .role {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }
  .people--exec li { padding: 1rem 1.1rem; border-top: 3px solid var(--teal); }
  .people--exec .role { color: var(--teal); }
  .people--exec .name { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.2; }

  .sponsors { grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); margin-top: 1.25rem; }
  .sponsors a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 1.1rem 1.25rem 1.2rem;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 12px;
    color: var(--ink);
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }
  .sponsors a::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--grad);
  }
  .sponsors a:hover { border-color: var(--teal); }
  .sponsors a:hover .name { text-decoration: underline; text-underline-offset: 3px; }
  .sponsors .name { font-weight: 600; line-height: 1.35; }
  .sponsors .org { font-size: 0.9rem; color: var(--ink-soft); }

  @media (max-width: 420px) {
    .wordmark { font-size: 2.35rem; }
  }
</style>
